---
layout: null
permalink: /search.json
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    {% assign category = site.data.categories | where: "id", post.category | first %}
    "category": {{ category.name | jsonify }},
    "categoryId": {{ post.category | jsonify }},
    "originalCategory": {{ post.originalCategory | default: "" | jsonify }},
    "description": {{ post.description | default: "" | jsonify }},
    "text": {{ post.content | plain_text | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
