{% from "icons.njk" import icon %}
<div class="post-list">
{% for post in posts %}{% set item = post.data.category | category %}
<article class="post-row" data-post-row><div class="post-row-content"><div class="post-meta-line"><a class="category-label {{ item.color }}" href="/categories/{{ item.id }}/">{{ item.name }}</a>{% if post.data.originalCategory %}<span class="meta-separator">/</span><span class="original-category">{{ post.data.originalCategory }}</span>{% endif %}</div><h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3><p class="post-excerpt">{{ post.data.description }}</p><div class="post-details"><time datetime="{{ post.date | isoDate }}">{{ post.date | dateLabel }}</time><span>·</span><span>{{ post.templateContent | readingTime }}분 읽기</span>{% if post.data.source %}<span class="imported-label">Tistory archive</span>{% endif %}</div></div><a class="post-arrow" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{{ icon('arrow') }}</a></article>
{% endfor %}
</div>
