{
  "name": "jmssup-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run preview:site",
    "build": "bash scripts/quartz.sh build",
    "preview:site": "bash scripts/quartz.sh preview",
    "sync:blog": "bash scripts/quartz.sh export",
    "check": "node scripts/check-quartz.mjs",
    "check:jekyll": "bundle exec jekyll build && node scripts/check.mjs",
    "import:tistory": "node scripts/import-tistory.mjs"
  },
  "devDependencies": {
    "cheerio": "^1.1.2"
  }
}
